async def test_camera(camera_id: int):
    """Делает тестовый снимок и СОХРАНЯЕТ его в БД для отображения в событиях/галерее"""
    import requests, os, uuid
    from datetime import datetime
    from pathlib import Path
    from main import SessionLocal, Screenshot, Camera, HTTPException

    db = SessionLocal()
    try:
        camera = db.query(Camera).filter(Camera.id == camera_id).first()
        if not camera: raise HTTPException(404, "Camera not found")

        # Скачиваем реальное фото с Orange Pi
        try:
            capture_url = f"http://{camera.device.ip}/capture?res={camera.resolution or '640'}"
            resp = requests.get(capture_url, timeout=25)  # увеличенный таймаут для RTSP
            if resp.status_code == 200 and len(resp.content) > 100:
                img_data = resp.content  # реальное фото!
            else:
                img_data = b''  # пустой ответ
        except Exception as e:
            print(f"Capture error: {e}")
            img_data = b''

        # Сохраняем файл
        filename = f"test_{uuid.uuid4().hex[:8]}.jpg"
        upload_dir = Path("uploads/resized")
        upload_dir.mkdir(parents=True, exist_ok=True)
        filepath = upload_dir / filename

        if img_data:
            with open(filepath, "wb") as f: f.write(img_data)
        else:
            # Минимальный валидный JPG (1x1 пиксель)
            with open(filepath, "wb") as f:
