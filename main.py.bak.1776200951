        # ============================================================
        # 4. Сохраняем файл и создаём запись в БД
        # ============================================================
        filename = f"test_{uuid.uuid4().hex[:8]}.jpg"
        upload_dir = Path("/app/uploads/resized")
        upload_dir.mkdir(parents=True, exist_ok=True)
        filepath = upload_dir / filename
        filepath.write_bytes(img_data)
        print(f"💾 [TEST] Файл сохранён: {filename} ({len(img_data)} байт)")
        
        # Создаём запись в БД
        screenshot = Screenshot(
            camera_id=camera_id,
            filename=filename,
            original_path=f"uploads/resized/{filename}",
            resized_path=f"uploads/resized/{filename}",
            ollama_response="📸 ТЕСТОВЫЙ КАДР",
            is_danger=False,
            created_at=datetime.now()
        )
        db.add(screenshot)
        db.commit()
        
        # Определяем источник для отчёта
        source = "ffmpeg" if len(img_data) > 5000 else ("orange_pi" if len(img_data) > 2000 else "placeholder")
        print(f"🔚 [TEST] Завершено. Источник: {source}")
        
        return {
            "status": "ok",
            "filename": filename,
            "size": len(img_data),
            "source": source
        }
        
    except Exception as e:
        db.rollback()
        import traceback
        traceback.print_exc()
        print(f"❌ [TEST] Критическая ошибка: {type(e).__name__}: {e}")
        raise HTTPException(500, str(e))
    finally:
        db.close()

if __name__ == "__main__":
    import uvicorn; uvicorn.run("main:app", host="0.0.0.0", port=8000, reload=False)
