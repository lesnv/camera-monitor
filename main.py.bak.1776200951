@app.get("/api/screenshots")
async def get_screenshots(date: str = None, limit: int = 12, page: int = 1):
    """Простой эндпоинт для событий"""
    from datetime import datetime
    from main import SessionLocal, Screenshot
    
    db = SessionLocal()
    try:
        query = db.query(Screenshot)
        if date:
            start = datetime.strptime(date, "%Y-%m-%d")
            end = start.replace(hour=23, minute=59, second=59)
            query = query.filter(Screenshot.created_at >= start, Screenshot.created_at <= end)
        
        total = query.count()
        items = query.order_by(Screenshot.created_at.desc()).offset((page-1)*limit).limit(limit).all()
        
        return {
            "items": [{
                "id": s.id,
                "time": s.created_at.isoformat() if s.created_at else None,
                "desc": s.ollama_response or "Нет описания",
                "danger": s.is_danger,
                "url": f"/uploads/resized/{s.filename}" if s.filename else None,
                "camera_id": s.camera_id
            } for s in items],
            "total": total,
            "page": page,
            "total_pages": (total + limit - 1) // limit if limit else 1
        }
    except Exception as e:
        import traceback; traceback.print_exc()
        return {"error": str(e), "items": []}
    finally:
        db.close()

@app.get("/api/gallery")
async def get_gallery(to_date: str = None, limit: int = 50):
    """Простой эндпоинт для галереи"""
    from datetime import datetime
    from main import SessionLocal, Screenshot
    
    db = SessionLocal()
    try:
        query = db.query(Screenshot).filter(Screenshot.filename != None)
        if to_date:
            end = datetime.strptime(to_date, "%Y-%m-%d").replace(hour=23, minute=59, second=59)
            query = query.filter(Screenshot.created_at <= end)
        
        items = query.order_by(Screenshot.created_at.desc()).limit(limit).all()
        
        return [{
            "id": s.id,
            "created_at": s.created_at.isoformat() if s.created_at else None,
            "url": f"/uploads/resized/{s.filename}",
            "desc": s.ollama_response or "",
            "camera_id": s.camera_id,
            "filename": s.filename
        } for s in items]
    except Exception as e:
        import traceback; traceback.print_exc()
        return []
    finally:
        db.close()


# === Раздача файлов из /app/uploads/ ===
from fastapi.responses import FileResponse
from pathlib import Path

@app.get("/uploads/{filepath:path}")
async def serve_uploaded_file(filepath: str):
    """Отдаёт файлы из /app/uploads/ с поддержкой подпапок"""
    # Абсолютный путь внутри контейнера
    base_path = Path("/app/uploads")
    file_path = base_path / filepath
    
    # Проверка безопасности: путь должен быть внутри base_path
    try:
        file_path = file_path.resolve()
        if not str(file_path).startswith(str(base_path.resolve())):
            return {"error": "Access denied"}
    except:
        return {"error": "Invalid path"}
    
    if file_path.exists() and file_path.is_file():
        return FileResponse(str(file_path), media_type="image/jpeg" if filepath.endswith('.jpg') else None)
    
    return {"error": "File not found", "path": str(file_path)}








async def test_camera(camera_id: int):
    import uuid, subprocess, os, tempfile, requests
    from datetime import datetime
    from pathlib import Path
    from main import SessionLocal, Screenshot, Camera, OrangePi, HTTPException
    
    db = SessionLocal()
    try:
        camera = db.query(Camera).filter(Camera.id == camera_id).first()
        if not camera:
            raise HTTPException(404, "Camera not found")
        
        img_data = b''
        rtsp_url = camera.rtsp_url
        
        # 1. Пытаемся захватить через FFmpeg на сервере
        if rtsp_url and rtsp_url.startswith('rtsp://'):
            print(f"[TEST] Trying FFmpeg capture: {rtsp_url[:60]}...")
            with tempfile.NamedTemporaryFile(suffix='.jpg', delete=False) as tmp:
                tmp_path = tmp.name
            try:
                cmd = [
                    'ffmpeg', '-rtsp_transport', 'tcp',
                    '-i', rtsp_url,
                    '-vframes', '1',
                    '-y', tmp_path
                ]
                res = subprocess.run(cmd, capture_output=True, timeout=20)
                if res.returncode == 0 and os.path.exists(tmp_path):
                    size = os.path.getsize(tmp_path)
                    print(f"[TEST] FFmpeg result: returncode={res.returncode}, size={size}")
                    if size > 500:
                        with open(tmp_path, 'rb') as f:
                            img_data = f.read()
                        print(f"[TEST] ✅ Captured {len(img_data)} bytes via FFmpeg")
            except subprocess.TimeoutExpired:
                print("[TEST] ⚠️ FFmpeg timeout")
            except Exception as e:
                print(f"[TEST] ⚠️ FFmpeg error: {e}")
            finally:
                if os.path.exists(tmp_path):
                    os.unlink(tmp_path)
        
        # 2. Фоллбэк: запрос к Orange Pi
        if not img_data or len(img_data) < 500:
            print("[TEST] Trying Orange Pi fallback...")
            pi = db.query(OrangePi).filter(OrangePi.id == camera.orange_pi_id).first()
            if pi and pi.ip:
                try:
                    capture_url = f"http://{pi.ip}/capture?res={camera.resolution or '640'}"
                    resp = requests.get(capture_url, timeout=15)
                    if resp.status_code == 200 and len(resp.content) > 500:
                        img_data = resp.content
                        print(f"[TEST] ✅ Captured {len(img_data)} bytes via Orange Pi")
                except Exception as e:
                    print(f"[TEST] ⚠️ Orange Pi error: {e}")
        
        # 3. Финальный фоллбэк: готовая заглушка из файла
        if not img_data or len(img_data) < 500:
            print("[TEST] Using placeholder file...")
            placeholder = Path("/app/uploads/resized/test_placeholder.jpg")
            if placeholder.exists():
                img_data = placeholder.read_bytes()
                print(f"[TEST] ✅ Loaded placeholder: {len(img_data)} bytes")
            else:
                # Крайний случай: минимальный валидный JPG (байты как список)
                jpg_header = bytes([
                    0xff,0xd8,0xff,0xe0,0x00,0x10,0x4a,0x46,0x49,0x46,0x00,0x01,0x01,0x00,0x00,0x01,
