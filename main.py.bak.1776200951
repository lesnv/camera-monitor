        import traceback
        traceback.print_exc()
        raise HTTPException(500, str(e))
    finally:
        db.close()


@app.post("/api/cameras/{camera_id}/test")
async def test_camera(camera_id: int):
    """Тест камеры: ПРИОРИТЕТ - захват через FFmpeg на сервере, фоллбэк - Orange Pi"""
    import uuid, subprocess, os, tempfile, requests
    from datetime import datetime
    from pathlib import Path
    from main import SessionLocal, Screenshot, Camera, OrangePi, HTTPException
    
    db = SessionLocal()
    try:
        camera = db.query(Camera).filter(Camera.id == camera_id).first()
        if not camera:
            raise HTTPException(404, "Camera not found")
        
        print(f"🔍 [TEST] Запрос для камеры #{camera_id}: {camera.name}")
        
        img_data = b''
        rtsp_url = camera.rtsp_url
        
        # ============================================================
        # 1. ПРИОРИТЕТ: Захват через FFmpeg НА СЕРВЕРЕ (если есть RTSP)
        #    Это работает, потому что 192.168.31.195 доступен с сервера 192.168.31.127
        # ============================================================
        if rtsp_url and rtsp_url.startswith('rtsp://'):
            print(f"🎬 [TEST] Пытаемся захватить через FFmpeg: {rtsp_url[:60]}...")
            with tempfile.NamedTemporaryFile(suffix='.jpg', delete=False) as tmp:
                tmp_path = tmp.name
            try:
                # Команда ffmpeg с увеличенным таймаутом для RTSP
                cmd = [
                    'ffmpeg',
                    '-rtsp_transport', 'tcp',  # TCP надёжнее для локальной сети
                    '-i', rtsp_url,
                    '-vframes', '1',           # Только один кадр
                    '-y',                       # Перезаписать если есть
                    tmp_path
                ]
                result = subprocess.run(cmd, capture_output=True, timeout=30)
                
                if result.returncode == 0 and os.path.exists(tmp_path):
                    size = os.path.getsize(tmp_path)
                    print(f"📊 [TEST] FFmpeg: returncode={result.returncode}, размер={size} байт")
                    
                    # Реальное фото обычно >2000 байт, заглушка ~300-400 байт
                    if size > 2000:
                        with open(tmp_path, 'rb') as f:
                            img_data = f.read()
                        print(f"✅ [TEST] Успешный захват через сервер: {len(img_data)} байт")
                    else:
                        print(f"⚠️ [TEST] FFmpeg вернул маленький файл ({size} байт) — возможно, ошибка потока")
                else:
                    stderr = result.stderr.decode()[:200] if result.stderr else "no output"
                    print(f"⚠️ [TEST] FFmpeg ошибка: {stderr}")
                    
            except subprocess.TimeoutExpired:
                print("⚠️ [TEST] FFmpeg таймаут (>30 сек)")
            except Exception as e:
                print(f"⚠️ [TEST] FFmpeg исключение: {type(e).__name__}: {e}")
            finally:
                # Всегда удаляем временный файл
                if os.path.exists(tmp_path):
                    os.unlink(tmp_path)
        
        # ============================================================
        # 2. ФОЛЛБЭК: Запрос к Orange Pi (если серверный захват не удался)
        # ============================================================
        if not img_data or len(img_data) < 2000:
            print("🔄 [TEST] Фоллбэк: пробуем запрос к Orange Pi...")
            pi = db.query(OrangePi).filter(OrangePi.id == camera.orange_pi_id).first()
            if pi and pi.ip:
                try:
                    capture_url = f"http://{pi.ip}/capture?res={camera.resolution or '640'}"
                    print(f"📡 [TEST] Запрос к Orange Pi: {capture_url}")
                    resp = requests.get(capture_url, timeout=20)
                    if resp.status_code == 200 and len(resp.content) > 2000:
                        img_data = resp.content
                        print(f"✅ [TEST] Получено через Orange Pi: {len(img_data)} байт")
                    else:
                        print(f"⚠️ [TEST] Orange Pi: HTTP {resp.status_code}, размер {len(resp.content)} байт")
                except Exception as e:
                    print(f"⚠️ [TEST] Orange Pi ошибка: {type(e).__name__}: {e}")
            else:
                print("⚠️ [TEST] Не найден Orange Pi для камеры")
        
        # ============================================================
        # 3. КРАЙНИЙ СЛУЧАЙ: Используем готовую заглушку из файла
        # ============================================================
        if not img_data or len(img_data) < 2000:
            print("🖼️ [TEST] Используем заглушку")
            placeholder = Path("/app/uploads/resized/test_placeholder.jpg")
            if placeholder.exists():
                img_data = placeholder.read_bytes()
                print(f"✅ [TEST] Загружена заглушка: {len(img_data)} байт")
            else:
                # Минимальный валидный JPG (1x1 пиксель) как последний фоллбэк
                img_data = bytes([
                    0xff,0xd8,0xff,0xe0,0x00,0x10,0x4a,0x46,0x49,0x46,0x00,0x01,0x01,0x00,0x00,0x01,
