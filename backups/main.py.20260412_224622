@app.post("/api/orangepi/heartbeat")
async def heartbeat(device_name: str = Form(...), ip: Optional[str] = Form(None), api_key: Optional[str] = Form(None),
                    cpu_load: float = Form(0.0), ram_usage: float = Form(0.0), storage_usage: float = Form(0.0),
                    connection_type: str = Form("unknown"), wifi_ssid: str = Form(None), temp_celsius: float = Form(0.0), db: Session = Depends(get_db)):
    dev = db.query(OrangePi).filter(OrangePi.name == device_name).first()
    now = datetime.utcnow()
    if not dev:
        dev = OrangePi(name=device_name, ip=ip, api_key=secrets.token_urlsafe(16), enabled=True, last_seen=now,
                       cpu_load=cpu_load, ram_usage=ram_usage, storage_usage=storage_usage,
                       connection_type=connection_type, wifi_ssid=wifi_ssid, temp_celsius=temp_celsius)
        db.add(dev); db.commit(); db.refresh(dev)
        return {"id": dev.id, "api_key": dev.api_key, "status": "registered", "commands": []}
    
    dev.ip = ip or dev.ip; dev.last_seen = now; dev.enabled = True
    dev.cpu_load = cpu_load; dev.ram_usage = ram_usage; dev.storage_usage = storage_usage
    dev.connection_type = connection_type; dev.wifi_ssid = wifi_ssid; dev.temp_celsius = temp_celsius
    db.commit()
    
    commands = COMMAND_QUEUE.get(dev.id, [])
    if commands: COMMAND_QUEUE[dev.id] = []
    return {"id": dev.id, "api_key": dev.api_key, "status": "updated", "commands": commands}

