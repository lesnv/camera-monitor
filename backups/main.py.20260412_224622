@app.post("/api/orangepi/{pi_id}/cameras")
async def add_camera(pi_id: int, data: dict, db: Session = Depends(get_db)):
    pi = db.query(OrangePi).filter(OrangePi.id == pi_id).first()
    if not pi: raise HTTPException(404, "Pi not found")
    if len(pi.cameras) >= MAX_CAMERAS_PER_PI: raise HTTPException(400, f"Максимум {MAX_CAMERAS_PER_PI} камер")
    cam_data = {"orange_pi_id": pi_id, "name": data.get("name"), "rtsp_url": data.get("rtsp_url"),
                "motion_interval": data.get("motion_interval", 10), "resolution": data.get("resolution", "640"),
                "analysis_prompt": data.get("analysis_prompt", DEFAULT_PROMPT),
                "report_prompt": data.get("report_prompt", "Опиши важные события за указанный период."),
                "analysis_model": data.get("analysis_model", "qwen2.5vl:3b"),
                "report_model": data.get("report_model", "qwen2.5vl:3b"), "enabled": data.get("enabled", True)}
    cam = Camera(**cam_data); db.add(cam); db.commit(); db.refresh(cam)
    return {"id": cam.id, "status": "created"}

@app.put("/api/cameras/{cam_id}")
async def update_camera(cam_id: int, data: dict, db: Session = Depends(get_db)):
    cam = db.query(Camera).filter(Camera.id == cam_id).first()
    if not cam: raise HTTPException(404, "Not found")
    allowed = ["name", "rtsp_url", "motion_interval", "resolution", "analysis_prompt", "report_prompt", "analysis_model", "report_model", "enabled"]
    for k, v in data.items():
        if k in allowed: setattr(cam, k, v)
    db.commit(); return {"status": "updated"}

