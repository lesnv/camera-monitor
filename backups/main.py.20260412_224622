@app.post("/api/upload/{camera_id}")
async def upload(camera_id: int, file: UploadFile = File(...), api_key: str = Header(None), 
                 is_test: str = Form("false"), db: Session = Depends(get_db)):
    cam = db.query(Camera).filter(Camera.id == camera_id, Camera.enabled).first()
    if not cam: raise HTTPException(404, "Camera disabled/not found")
    pi = db.query(OrangePi).filter(OrangePi.id == cam.orange_pi_id).first()
    ts = datetime.utcnow().strftime("%Y%m%d_%H%M%S"); fn = f"cam{camera_id}_{ts}_{secrets.token_hex(4)}.jpg"
    storage_path = get_camera_storage_path(camera_id, cam.orange_pi_id) if pi else UPLOAD_DIR / "original"
    storage_path.mkdir(parents=True, exist_ok=True)
    save_path = storage_path / fn
    with open(save_path, "wb") as f: f.write(await file.read())
    asyncio.create_task(process_screenshot(camera_id, save_path, cam.resolution, cam.analysis_prompt or DEFAULT_PROMPT, cam.analysis_model or "qwen2.5vl:3b", db))
    return {"status": "queued", "filename": fn, "path": str(save_path)}

@app.get("/api/screenshots/pi/{pi_id}")
async def get_screenshots_pi(pi_id: int, limit: int = 50, db: Session = Depends(get_db)):
    cam_ids = [c.id for c in db.query(Camera).filter(Camera.orange_pi_id == pi_id).all()]
    if not cam_ids: return []
    items = db.query(Screenshot).filter(Screenshot.camera_id.in_(cam_ids)).order_by(Screenshot.created_at.desc()).limit(limit).all()
    return [{"id": s.id, "cam_id": s.camera_id, "url": f"/uploads/resized/resized_{s.filename}" if s.resized_path else None,
             "desc": s.ollama_response, "danger": s.is_danger, "time": s.created_at} for s in items]


