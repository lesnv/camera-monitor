@app.put("/api/orangepi/{pi_id}/name")
async def update_pi_name(pi_id: int, data: dict, db: Session = Depends(get_db)):
    pi = db.query(OrangePi).filter(OrangePi.id == pi_id).first()
    if not pi: raise HTTPException(404, "Not found")
    pi.name = data.get("name", pi.name); db.commit()
    return {"status": "updated", "name": pi.name}

@app.post("/api/orangepi/{pi_id}/cameras")
async def add_camera(pi_id: int, data: dict, db: Session = Depends(get_db)):
    pi = db.query(OrangePi).filter(OrangePi.id == pi_id).first()
    if not pi: raise HTTPException(404, "Pi not found")
    if len(pi.cameras) >= MAX_CAMERAS_PER_PI: raise HTTPException(400, f"Максимум {MAX_CAMERAS_PER_PI} камер")
    cam_data = {"orange_pi_id": pi_id, "name": data.get("name"), "rtsp_url": data.get("rtsp_url"),
                "motion_interval": data.get("motion_interval", 10), "resolution": data.get("resolution", "640"),
                "analysis_prompt": data.get("analysis_prompt", DEFAULT_PROMPT),
                "report_prompt": data.get("report_prompt", "Опиши важные события за указанный период."),
                "analysis_model": data.get("analysis_model", "qwen2.5vl:3b"),
                "report_model": data.get("report_model", "qwen2.5vl:3b"), "enabled": data.get("enabled", True)}
    cam = Camera(**cam_data); db.add(cam); db.commit(); db.refresh(cam)
    return {"id": cam.id, "status": "created"}

@app.put("/api/cameras/{cam_id}")
async def update_camera(cam_id: int, data: dict, db: Session = Depends(get_db)):
    cam = db.query(Camera).filter(Camera.id == cam_id).first()
    if not cam: raise HTTPException(404, "Not found")
    allowed = ["name", "rtsp_url", "motion_interval", "resolution", "analysis_prompt", "report_prompt", "analysis_model", "report_model", "enabled"]
    for k, v in data.items():
        if k in allowed: setattr(cam, k, v)
    db.commit(); return {"status": "updated"}

@app.delete("/api/cameras/{cam_id}")
async def delete_camera(cam_id: int, db: Session = Depends(get_db)):
    cam = db.query(Camera).filter(Camera.id == cam_id).first()
    if not cam: raise HTTPException(404, "Not found")
    db.delete(cam); db.commit(); return {"status": "deleted"}

async def get_screenshots_pi(pi_id: int, limit: int = 50, db: Session = Depends(get_db)):
    cam_ids = [c.id for c in db.query(Camera).filter(Camera.orange_pi_id == pi_id).all()]
    if not cam_ids: return []
    items = db.query(Screenshot).filter(Screenshot.camera_id.in_(cam_ids)).order_by(Screenshot.created_at.desc()).limit(limit).all()
    return [{"id": s.id, "cam_id": s.camera_id, "url": f"/uploads/resized/resized_{s.filename}" if s.resized_path else None,
             "desc": s.ollama_response, "danger": s.is_danger, "time": s.created_at} for s in items]


@app.post("/api/orangepi/{pi_id}/sync-time")
async def sync_orangepi_time(pi_id: int, db: Session = Depends(get_db)):
    """Отправляет команду на синхронизацию времени с сервером"""
    pi = db.query(OrangePi).filter(OrangePi.id == pi_id).first()
    if not pi: raise HTTPException(404, "Not found")
    if pi_id not in COMMAND_QUEUE: COMMAND_QUEUE[pi_id] = []
    COMMAND_QUEUE[pi_id].append({"action": "sync_time", "server_time": datetime.utcnow().isoformat()})
    return {"status": "queued", "message": "Time sync command sent"}

@app.get("/api/orangepi/{pi_id}/folders")
async def get_pi_folders(pi_id: int, db: Session = Depends(get_db)):
    """Возвращает структуру папок с фото, ищет файлы рекурсивно"""
    pi_folder = UPLOAD_DIR / f"pi_{pi_id}"
    if not pi_folder.exists(): return {"folders": []}
    folders = []
    # Ищем все папки с датой (рекурсивно)
    for day_folder in sorted(pi_folder.rglob("*"), reverse=True):
        if day_folder.is_dir() and day_folder.name.count("-") == 2 and len(day_folder.name) == 10:
            try:
                cameras = []
                # В папке даты ищем подпапки camera_X
                for cam_folder in day_folder.iterdir():
                    if cam_folder.is_dir() and cam_folder.name.startswith("camera_"):
                        cam_id = cam_folder.name.replace("camera_", "")
                        files = [f.name for f in sorted(cam_folder.glob("*.jpg"), reverse=True)]
                        if files:
                            cameras.append({"camera_id": cam_id, "count": len(files), "files": files[:20]})
                if cameras:
                    # Проверяем, нет ли уже такой даты в списке
                    if not any(f["date"] == day_folder.name for f in folders):
                        folders.append({"date": day_folder.name, "cameras": cameras})
            except Exception as e:
                logger.warning(f"Folder parse error: {e}")
    return {"folders": sorted(folders, key=lambda x: x["date"], reverse=True)[:30]}


@app.get("/device/{pi_id}/cameras.html")
async def device_cameras_page(pi_id: int):
    """Отдаёт страницу настроек камер для конкретного устройства"""
    from fastapi.responses import FileResponse, HTMLResponse
    import os
    template_path = Path(__file__).parent / "static" / "device_template.html"
    if not template_path.exists():
        return HTMLResponse("Template not found", status_code=404)
    
    # Читаем шаблон и подставляем переменные
    with open(template_path, 'r', encoding='utf-8') as f:
        html = f.read()
    
    # Получаем данные устройства для подстановки
    db = SessionLocal()
    pi = db.query(OrangePi).filter(OrangePi.id == pi_id).first()
    db.close()
    
    if pi:
        html = html.replace('{{DEVICE_NAME}}', pi.name or f'Device {pi_id}')
        html = html.replace('{{DEVICE_IP}}', pi.ip or '—')
        html = html.replace('{{DEVICE_ID}}', str(pi_id))
    else:
        html = html.replace('{{DEVICE_NAME}}', f'Unknown #{pi_id}')
        html = html.replace('{{DEVICE_IP}}', '—')
        html = html.replace('{{DEVICE_ID}}', str(pi_id))
    
    return HTMLResponse(content=html, status_code=200)




