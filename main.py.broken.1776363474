            model = camera.analysis_model or "qwen2.5vl:3b"
            prompt = camera.analysis_prompt or "Кратко опиши что на кадре, если есть опасность укажи об этом."
            
            print(f"🧠 [TEST] Ollama: {model}")
            resp = requests.post(
